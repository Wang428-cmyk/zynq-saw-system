# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y0 [get_cells dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck]
set_property LOC BUFGCTRL_X0Y20 [get_cells clock/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y19 [get_cells clock/inst/clkout3_buf]
set_property LOC BUFGCTRL_X0Y18 [get_cells clock/inst/clkout2_buf]
set_property LOC BUFGCTRL_X0Y16 [get_cells clock/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y17 [get_cells System_wrapper_inst0/System_i/processing_system7_0/inst/buffer_fclk_clk_0.FCLK_CLK_0_BUFG]

# Location of IO Primitives which is load of clock spine
